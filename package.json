{
  "name": "open-local-audit",
  "version": "0.77.0",
  "description": "Open-source website and local presence auditor for small businesses.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "open-local-audit": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/guides/free-discovery.md",
    "docs/architecture/workflow-command.md",
    "docs/architecture/workflow-preflight.md",
    "docs/architecture/workflow-plan.md",
    "docs/architecture/workflow-resume.md",
    "docs/architecture/workflow-status.md"
  ],
  "scripts": {
    "benchmark:discovery": "tsx scripts/benchmark-discovery.ts",
    "build": "tsc -p tsconfig.build.json",
    "fresh-install-check": "node scripts/fresh-install-check.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "release-check": "npm run lint && npm test && npm run build && npm audit && npm pack --dry-run && npm run fresh-install-check",
    "test": "vitest run",
    "start": "tsx src/cli.ts"
  },
  "keywords": [
    "local-seo",
    "website-audit",
    "small-business",
    "cli",
    "seo",
    "accessibility",
    "structured-data",
    "local-business"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esquetta/open-local-audit.git"
  },
  "bugs": {
    "url": "https://github.com/Esquetta/open-local-audit/issues"
  },
  "homepage": "https://github.com/Esquetta/open-local-audit#readme",
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.6-r.1",
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.1",
    "commander": "^12.1.0",
    "fflate": "^0.8.3",
    "libphonenumber-js": "^1.13.14",
    "lighthouse": "13.5.0",
    "pdfkit": "^0.18.0",
    "robots-parser": "^3.0.1",
    "undici": "7.30.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
